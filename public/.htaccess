# mod_dir anade por su cuenta un 301 de /blog a /blog/ en cuanto existe el
# directorio blog/ (donde viven los posts prerenderizados), y lo hace ANTES de
# que corra mod_rewrite, asi que la regla PRERENDER de abajo no llegaba a
# servir blog.html: /blog -> 301 -> /blog/ -> 403, con el indice del blog caido.
# Esa barra final ademas contradiria el <link rel="canonical"> de la pagina.
# Aqui ningun directorio se sirve por si mismo (no hay ningun index.html dentro
# de assets/, images/ o data/), asi que no perdemos nada desactivandolo.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

# Sin DirectorySlash, un directorio sin index podria intentar listarse.
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- PRERENDER ---
  # tools/prerender.mjs genera un .html plano por ruta publica
  # (p. ej. blog/mi-post.html). Si existe, se sirve tal cual: los bots que no
  # ejecutan JS (GPTBot, ClaudeBot, PerplexityBot) reciben el contenido real
  # en vez del index.html vacio de la SPA.
  # Son ficheros planos y no directorios a proposito: con blog/mi-post/index.html
  # mod_dir redirigiria /blog/mi-post -> /blog/mi-post/ (301), y esa barra final
  # contradiria el <link rel="canonical"> que emite la propia pagina.
  # Se sirve internamente, sin redireccion, asi que la URL no cambia.
  #
  # OJO con dos detalles, ambos aprendidos rompiendo /blog en produccion:
  #  1) NO se filtra por !-d. /blog es a la vez fichero (blog.html) y directorio
  #     (blog/, con los posts). Con !-d la regla no entraba, mod_dir redirigia
  #     /blog -> /blog/ (301) y ese directorio no tiene index.html: 403.
  #     La condicion de que exista el .html ya es bastante especifica; los
  #     directorios reales (images/, assets/) no tienen un .html hermano.
  #  2) El patron admite barra final opcional para que /blog/ sirva blog.html
  #     en vez de caer en el 403 de mod_dir.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]

  # --- FALLBACK SPA ---
  # Rutas sin prerender (login, dashboard, duelos...) y 404: las pinta React.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Powered-By "Hostinger Horizons"

  # --- Cabeceras de seguridad ---
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=(), payment=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Content-Security-Policy. Ajustar connect-src/script-src si se anaden CDNs.
  # form-action incluye Supabase y Google para no bloquear los redirects / form
  # intermedios del flujo OAuth (Chrome aplica form-action tambien al URL final
  # de una redireccion en cadena si se origino con una submission).
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://*.supabase.co https://accounts.google.com https://*.google.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://apis.google.com https://accounts.google.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https: https://*.googleusercontent.com; media-src 'self' data: blob: https:; worker-src 'self' blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://apis.google.com https://accounts.google.com https://oauth2.googleapis.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-src 'self' https://accounts.google.com https://*.supabase.co https://www.youtube-nocookie.com https://www.youtube.com;"
</IfModule>
